<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="patientportal" transaction-type="RESOURCE_LOCAL">

        <!-- Registered entity classes -->
        <!-- User hierarchy: SINGLE_TABLE → all stored in the "users" table -->
        <class>edu.secourse.patientportal.models.User</class>
        <class>edu.secourse.patientportal.models.Patient</class>
        <class>edu.secourse.patientportal.models.Doctor</class>
        <class>edu.secourse.patientportal.models.Admin</class>
        <class>edu.secourse.patientportal.models.Appointment</class>

        <properties>
            <!-- ===== MySQL connection — update credentials below ===== -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/patientportal?useSSL=false&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user"     value="root"/>
            <!-- ⚠️  Remplace "" par ton mot de passe MySQL si tu en as un -->
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- ===== Hibernate settings ===== -->
            <!-- update  → auto-create/alter tables on startup          -->
            <!-- validate → only validate (use in production)           -->
            <!-- create  → drop + recreate every start (dev only)       -->
            <property name="hibernate.hbm2ddl.auto"  value="update"/>
            <property name="hibernate.dialect"        value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql"       value="true"/>
            <property name="hibernate.format_sql"     value="true"/>
        </properties>
    </persistence-unit>

</persistence>
