name: Java CI - Patient Appointment Unit Tests

on:
  push:
    branches: [ main, final_backend, dev ]
  pull_request:
    branches: [ main, final_backend, dev ]

jobs:
  backend-tests:
    name: Backend Tests - Java 21
    runs-on: ubuntu-latest

    defaults:
      run:
        working-directory: patient-portal

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      - name: Set up Java 21
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '21'
          cache: maven
          cache-dependency-path: patient-portal/pom.xml

      - name: Run backend tests
        run: mvn clean test

      - name: Upload backend test reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: backend-test-reports
          path: |
            patient-portal/target/surefire-reports/
            patient-portal/target/failsafe-reports/

  frontend-tests:
    name: Frontend Tests - Java 26
    runs-on: ubuntu-latest

    defaults:
      run:
        working-directory: Medical-Portal-App

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      - name: Set up Java 26
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '26'
          cache: maven
          cache-dependency-path: Medical-Portal-App/pom.xml

      - name: Run frontend tests
        run: mvn clean test

      - name: Upload frontend test reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: frontend-test-reports
          path: |
            Medical-Portal-App/target/surefire-reports/
            Medical-Portal-App/target/failsafe-reports/
